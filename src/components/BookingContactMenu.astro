---
import { site } from '@/data/site';
import '@/styles/booking-contact.css';

const telegramUrl = 'https://t.me/kashalotik_chertanovo';
const maxUrl = 'https://max.ru/u/f9LHodD0cOI7v_lRlfrbz6iMu2TjlwYfUsJTAvi-BAkUfXfOelWPH24mcJI';
---

<dialog class="booking-contact-dialog" data-booking-contact-dialog aria-labelledby="booking-contact-title">
  <div class="booking-contact-sheet">
    <button class="booking-contact-close" type="button" aria-label="Закрыть окно записи" data-booking-contact-close>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
    </button>
    <div class="booking-contact-heading">
      <small>Запись на занятие</small>
      <h2 id="booking-contact-title">Как вам удобнее записаться?</h2>
    </div>
    <div class="booking-contact-options">
      <a href={telegramUrl} target="_blank" rel="noopener noreferrer">
        <span class="contact-option-icon is-telegram" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20.7 4.1 3.9 10.6c-1.1.4-1.1 1.1-.2 1.4l4.3 1.3 1.7 5.2c.2.6.1.8.7.8.5 0 .7-.2 1-.5l2.1-2 4.4 3.2c.8.5 1.4.2 1.6-.8l2.8-13.4c.3-1.3-.5-1.9-1.6-1.7ZM9 13l8.4-5.3c.4-.3.8-.1.5.2l-6.9 6.3-.3 3.1L9 13Z" /></svg>
        </span>
        <span><strong>Telegram</strong><small>Написать администратору</small></span>
        <svg class="contact-option-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      </a>
      <a href={maxUrl} target="_blank" rel="noopener noreferrer">
        <span class="contact-option-icon is-max" aria-hidden="true">
          <svg viewBox="0 0 24 24"><defs><linearGradient id="max-gradient" x1="2" y1="22" x2="22" y2="2"><stop stop-color="#00bfff"/><stop offset=".52" stop-color="#6e1aff"/><stop offset="1" stop-color="#9500ff"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="7" fill="url(#max-gradient)"/><path d="M6.5 15.8V8.2h2.2l3.3 4.1 3.3-4.1h2.2v7.6h-2.4v-4.2L12 15.4l-3.1-3.8v4.2H6.5Z" fill="#fff"/></svg>
        </span>
        <span><strong>MAX</strong><small>Написать в мессенджере</small></span>
        <svg class="contact-option-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      </a>
      <a href={site.phoneHref}>
        <span class="contact-option-icon is-phone" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M7.4 3.5 10 7.8 8.3 9.5c1 2.2 3 4.2 5.2 5.2l1.7-1.7 4.3 2.6-.7 3.6c-.2.9-1 1.5-1.9 1.4C9.8 20 4 14.2 3.4 7.1c-.1-.9.5-1.7 1.4-1.9l2.6-.7Z" /></svg>
        </span>
        <span><strong>Позвонить</strong><small>{site.phone}</small></span>
        <svg class="contact-option-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      </a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-booking-contact-dialog]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-booking-contact-close]');
  let trigger: HTMLElement | null = null;

  document.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const nextTrigger = target.closest<HTMLElement>('[data-booking-contact]');
    if (nextTrigger && dialog) {
      trigger = nextTrigger;
      dialog.showModal();
      return;
    }
    if (target === dialog) dialog.close();
  });

  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('cancel', event => {
    event.preventDefault();
    dialog.close();
  });
  dialog?.addEventListener('close', () => trigger?.focus());
</script>
