---
import { base, site } from '@/data/site';
const image = (name: string) => `${base}assets/images/${name}`;
const slides = [
  { eyebrow: 'Детский бассейн в Чертаново', title: 'Первые шаги\nк большим достижениям', text: 'Индивидуальные занятия плаванием для детей от 1 месяца до 10 лет в тёплой воде 32–34 °C.', image: image('hero-clean-v2.webp') },
  { eyebrow: 'От 1 месяца до 10 лет', title: 'Вода, игра\nи забота', text: 'Индивидуальные занятия с тренером в чистой тёплой воде 32–34 °C.', image: image('pool-action-2-enhanced.webp') },
  { eyebrow: 'Пробное занятие', title: 'Познакомимся\nс водой вместе', text: '30 минут бережного знакомства с бассейном и тренером — 1 500 ₽.', image: image('pool-action-1-enhanced.webp') },
];
---
<section class="hero-slider swiper" aria-label="Главные предложения">
  <div class="swiper-wrapper">
    {slides.map((slide, index) => (
      <article class="swiper-slide hero-slide">
        <div class="container hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">{slide.eyebrow}</span>
            {index === 0
              ? <h1 class="hand hero-title">{slide.title.split('\n').map(line => <>{line}<br /></>)}</h1>
              : <h2 class="hand hero-title">{slide.title.split('\n').map(line => <>{line}<br /></>)}</h2>}
            <p>{slide.text}</p>
            {index === 0 && <div class="hero-proof"><span>Один ребёнок — один тренер</span><span>Пробное занятие — 1 500 ₽</span></div>}
            <a class="button" href={site.booking}>Записаться на пробное занятие</a>
          </div>
          <div class:list={["hero-media", index === 0 ? "reference-media" : "playful-media"]} style={index > 0 ? `--splash-blue:url('${image('slider-splash-blue.svg')}');--splash-pink:url('${image('slider-splash-pink.svg')}')` : undefined}>
            <img src={slide.image} alt="Занятие в бассейне Кашалотик" loading={index === 0 ? 'eager' : 'lazy'} />
            {index > 0 && <>
              <i class="water-splash splash-blue" aria-hidden="true"></i>
              <i class="water-splash splash-pink" aria-hidden="true"></i>
              <i class="water-bubble bubble-one" aria-hidden="true"></i>
              <i class="water-bubble bubble-two" aria-hidden="true"></i>
              <i class="water-bubble bubble-three" aria-hidden="true"></i>
            </>}
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="container hero-trust" data-reveal-group>
    <div><i>💧</i><span>Чистая и тёплая<br /><b>вода 32–34 °C</b></span></div>
    <div><i>♡</i><span>Опытные тренеры<br /><b>индивидуальный подход</b></span></div>
    <div><i>✓</i><span>Безопасность<br /><b>и комфорт</b></span></div>
    <div><i>☺</i><span>Здоровье<br /><b>и уверенность</b></span></div>
  </div>
  <div class="swiper-pagination"></div>
  <button class="slider-prev" aria-label="Предыдущий слайд">←</button>
  <button class="slider-next" aria-label="Следующий слайд">→</button>
</section>
<script>
  import Swiper from 'swiper';
  import { animate } from 'motion';
  import { Autoplay, Keyboard, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  const slider = new Swiper('.hero-slider', {
    modules: [Autoplay, Keyboard, Navigation, Pagination],
    loop: true,
    speed: 750,
    keyboard: { enabled: true },
    autoplay: { delay: 7000, disableOnInteraction: false, pauseOnMouseEnter: true },
    navigation: { prevEl: '.slider-prev', nextEl: '.slider-next' },
    pagination: { el: '.swiper-pagination', clickable: true },
  });
  const animateSlide = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const active = slider.slides[slider.activeIndex];
    const copy = active?.querySelector('.hero-copy');
    const media = active?.querySelector('.hero-media');
    if (copy) animate(copy, { opacity: [0, 1], x: [-22, 0] }, { duration: 0.6, ease: 'easeOut' });
    if (media) animate(media, { opacity: [0, 1], scale: [0.97, 1] }, { duration: 0.75, ease: 'easeOut' });
  };
  slider.on('slideChangeTransitionStart', animateSlide);
  animateSlide();
</script>
