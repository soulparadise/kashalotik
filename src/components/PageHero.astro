---
interface Props { eyebrow: string; title: string; text: string; }
const { eyebrow, title, text } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="hand">{title}</h1>
    <p>{text}</p>
  </div>
  <span class="page-whale" aria-hidden="true">🐳</span>
</section>
