---
interface Props { eyebrow: string; title: string; text: string; mascotMessages?: string[]; }
const defaultMascotMessages = [
  'Наша команда лучше всех!',
  'Здесь вода всегда тёплая!',
  'Учимся плавать с улыбкой!',
  'Каждому малышу — свой тренер!',
  'Чистая вода 32–34 °C!',
  'Растим уверенных пловцов!',
  'Первые нырки — без страха!',
  'Играем, учимся, плаваем!',
  'Заботимся о каждом ребёнке!',
  'В «Кашалотике» вода в радость!',
];
const { eyebrow, title, text, mascotMessages = defaultMascotMessages } = Astro.props;
const mascotMessage = mascotMessages[0];
---
<section class="page-hero">
  <div class="container page-hero-inner">
    <div class="page-hero-copy" data-reveal-group>
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="hand">{title}</h1>
      <p>{text}</p>
    </div>
    <div class:list={['page-mascot', mascotMessage && 'has-message']} data-float data-mascot-messages={mascotMessage ? JSON.stringify(mascotMessages) : undefined} tabindex={mascotMessage ? 0 : undefined}>
      {mascotMessage && <span class="mascot-speech">{mascotMessage}</span>}
      <span class="page-whale mascot-crop" aria-hidden="true"><img src={`${import.meta.env.BASE_URL}assets/images/logo-2026.svg`} alt="" /></span>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-mascot-messages]').forEach((mascot) => {
    const speech = mascot.querySelector<HTMLElement>('.mascot-speech');
    const messages = JSON.parse(mascot.dataset.mascotMessages || '[]') as string[];
    const autoplayDelay = Number(mascot.dataset.mascotAutoplay || 0);
    let current = 0;
    const chooseMessage = () => {
      if (!speech || messages.length < 2) return;
      let next = current;
      while (next === current) next = Math.floor(Math.random() * messages.length);
      current = next;
      speech.textContent = messages[current];
    };
    mascot.addEventListener('pointerenter', chooseMessage);
    mascot.addEventListener('focus', chooseMessage);
    if (autoplayDelay > 0 && messages.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.setInterval(chooseMessage, autoplayDelay);
    }
  });
</script>
