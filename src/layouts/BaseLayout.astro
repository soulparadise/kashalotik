---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RevealAnimations from '@/components/RevealAnimations.astro';
import '@/styles/global.css';
import '@/styles/inner-pages.css';
import '@/styles/header-nav.css';
import '@/styles/animations.css';
import '@/styles/menu-font.css';
import '@/styles/design-polish.css';
interface Props { title: string; description: string; bodyClass?: string; }
const { title, description, bodyClass } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <Header />
    <slot />
    <Footer />
    <RevealAnimations />
  </body>
</html>
