---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import PricingSection from '@/components/PricingSection.astro';
import WaveSection from '@/components/WaveSection.astro';
import { programs, trainers } from '@/data/content';
import { base, site } from '@/data/site';
import '@/styles/home.css';

const featuredReviews = [
  {
    text: 'Сын научился плавать с нуля. Теперь на занятия планируем отдать еще и старшую дочь.',
    date: '15 марта',
  },
  {
    text: 'Чисто и уютно. Приятные администраторы. А самое главное - ребёнок с удовольствием ходит и гордится своими результатами.',
    date: '10 октября 2025',
    dateTime: '2025-10-10',
  },
  {
    text: 'Дочка занимается с удовольствием, тренера внимательные и терпеливые. Вода чистая, температура комфортная, раздевалки и душевые в хорошем состоянии.',
    date: '25 июня',
  },
];
---
<BaseLayout title="Детский бассейн в Чертаново — индивидуальное плавание | Кашалотик" description="Детский бассейн «Кашалотик» в Чертаново: индивидуальные занятия для детей от 1 месяца до 10 лет, вода 32–34 °C и опытные тренеры. Запишитесь на пробное занятие." bodyClass="home-font-concept">
  <main>
    <HeroSlider />
    <WaveSection tone="blue">
      <div class="container"><div class="section-title" data-reveal><h2 class="hand"><span>〰</span>Наши занятия<span>〰</span></h2><p>Знакомство с водой, развитие навыков и уверенное плавание.</p></div><div class="lesson-grid" data-reveal-group>{programs.slice(0,3).map(p => <article class="lesson-card"><img src={p.image} alt={p.title} /><div><h3>{p.title}</h3><strong>{p.age}</strong><p>{p.text}</p><a href={`${base}programs/`}>Подробнее →</a></div></article>)}</div></div>
    </WaveSection>
    <PricingSection />
    <WaveSection tone="blue">
      <div class="container"><div class="section-title" data-reveal><h2 class="hand"><span>〰</span>Наши тренеры<span>〰</span></h2><p>Профессионалы, искренне любящие детей и свою работу.</p></div><div class="trainer-grid" data-reveal-group>{trainers.map(t => <article class="trainer-card"><img src={t.image} alt={`${t.name}, тренер`} /><div><h3>{t.name}</h3><p>{t.role}</p></div></article>)}</div><div class="section-action"><a href={`${base}team/`}>Познакомиться с командой →</a></div></div>
    </WaveSection>
    <WaveSection>
      <div class="container why-panel" data-reveal><div><h2 class="hand">Почему выбирают нас</h2><div class="why-grid"><span>♡<b>Индивидуальный подход</b></span><span>⚓<b>Забота о каждом ребёнке</b></span><span>💧<b>Чистая вода 32–34 °C</b></span></div><div class="why-link"><a href={`${base}safety/`}>Как мы заботимся о воде →</a></div></div><img src={`${base}assets/images/pool-action-1.webp`} alt="Занятие в бассейне" /></div>
    </WaveSection>
    <WaveSection tone="blue" class="trust-section">
      <div class="container">
        <div class="section-title" data-reveal>
          <h2 class="hand"><span>〰</span>Забота, которой доверяют<span>〰</span></h2>
        </div>
        <a class="trust-award" href={site.maps} aria-label="Кашалотик — Хорошее место 2026, рейтинг 4,9 из 5 на Яндекс Картах" data-reveal>
          <span class="trust-award__image">
            <img src={`${base}assets/images/yandex-good-place-2026.png`} alt="" loading="lazy" width="1200" height="630" />
          </span>
          <span class="trust-award__content">
            <span class="trust-award__eyebrow">Награда Яндекс Карт</span>
            <strong>Хорошее место 2026</strong>
            <span class="trust-award__rating"><b>4,9</b><small>на Яндекс Картах</small></span>
          </span>
        </a>
        <div class="trust-grid" data-reveal-group>
          {featuredReviews.map(review => (
            <article>
              <div class="review-stars" aria-label="Оценка 5 из 5"><span aria-hidden="true">★★★★★</span></div>
              <blockquote>«{review.text}»</blockquote>
              <a class="review-source" href={`${site.maps}reviews/`}>
                <strong>Яндекс Карты</strong>
                {review.dateTime ? <time datetime={review.dateTime}>{review.date}</time> : <span>{review.date}</span>}
              </a>
            </article>
          ))}
        </div>
        <div class="section-action"><a class="button secondary" href={`${site.maps}reviews/`}>Все отзывы на Яндекс Картах</a></div>
      </div>
    </WaveSection>
  </main>
</BaseLayout>
