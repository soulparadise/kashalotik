---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import WaveSection from '@/components/WaveSection.astro';
import { prices, programs, trainers } from '@/data/content';
import { base, site } from '@/data/site';
import '@/styles/home.css';
---
<BaseLayout title="Кашалотик — детский бассейн" description="Индивидуальное плавание для детей от 1 месяца до 10 лет в Москве.">
  <main>
    <HeroSlider />
    <WaveSection tone="blue">
      <div class="container"><div class="section-title" data-reveal><h2 class="hand"><span>〰</span>Наши занятия<span>〰</span></h2><p>Знакомство с водой, развитие навыков и уверенное плавание.</p></div><div class="lesson-grid" data-reveal-group>{programs.slice(0,3).map(p => <article class="lesson-card"><img src={p.image} alt={p.title} /><div><h3>{p.title}</h3><strong>{p.age}</strong><p>{p.text}</p><a href={`${base}programs/`}>Подробнее →</a></div></article>)}</div></div>
    </WaveSection>
    <WaveSection>
      <div class="container"><div class="section-title" data-reveal><h2 class="hand"><span>〰</span>Абонементы и цены<span>〰</span></h2><p>Индивидуальные занятия продолжительностью 30 или 45 минут.</p></div><div class="price-grid" data-reveal-group>{prices.map(p => <article class:list={['price-card', p.featured && 'featured']}><small>{p.featured ? 'Первое знакомство' : 'Абонемент'}</small><h3>{p.title}</h3><strong>{p.price}</strong><p>{p.note}</p>{p.extra && <p>{p.extra}</p>}{p.featured && <a class="button" href={site.booking}>Записаться</a>}</article>)}</div><div class="section-action"><a href={`${base}prices/`}>Все тарифы и условия →</a></div></div>
    </WaveSection>
    <WaveSection tone="blue">
      <div class="container"><div class="section-title" data-reveal><h2 class="hand"><span>〰</span>Наши тренеры<span>〰</span></h2><p>Профессионалы, искренне любящие детей и свою работу.</p></div><div class="trainer-grid" data-reveal-group>{trainers.map(t => <article class="trainer-card"><img src={t.image} alt={`${t.name}, тренер`} /><div><h3 class="hand">{t.name}</h3><p>{t.role}</p></div></article>)}</div><div class="section-action"><a href={`${base}team/`}>Познакомиться с командой →</a></div></div>
    </WaveSection>
    <WaveSection>
      <div class="container why-panel" data-reveal><div><h2 class="hand">Почему выбирают нас</h2><div class="why-grid"><span>♡<b>Индивидуальный подход</b></span><span>⚓<b>Забота о каждом ребёнке</b></span><span>💧<b>Чистая вода 32–34 °C</b></span></div><div class="why-link"><a href={`${base}safety/`}>Как мы заботимся о воде →</a></div></div><img src={`${base}assets/images/pool-action-1.webp`} alt="Занятие в бассейне" /></div>
    </WaveSection>
    <WaveSection tone="blue" class="trust-section">
      <div class="container"><div class="section-title" data-reveal><h2 class="hand"><span>〰</span>Забота, которой доверяют<span>〰</span></h2></div><div class="trust-grid" data-reveal-group><article><b>“</b><p>В воде находятся только ребёнок и тренер — всё внимание направлено на малыша.</p><strong>Индивидуальный формат</strong></article><article><b>“</b><p>Современная многоступенчатая фильтрация и комфортная температура 32–34 °C.</p><strong>Чистота и безопасность</strong></article><article><b>“</b><p>Раздевалка, пеленальные столики и игровая зона для отдыха после занятия.</p><strong>Комфорт для семьи</strong></article></div><div class="section-action"><a class="button secondary" href={`${base}reviews/`}>Отзывы и факты о бассейне</a></div></div>
    </WaveSection>
    <section class="home-cta"><div class="container"><span class="cta-whale" aria-hidden="true">🐳</span><div><h2 class="hand">Подарите ребёнку уверенность<br />и радость движения!</h2><p>Запишитесь на пробное занятие</p></div><a class="button" href={site.booking}>Записаться →</a></div></section>
  </main>
</BaseLayout>
