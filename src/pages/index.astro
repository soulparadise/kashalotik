---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import WaveSection from '@/components/WaveSection.astro';
import { prices, programs, trainers } from '@/data/content';
import { site } from '@/data/site';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Кашалотик — детский бассейн" description="Индивидуальное плавание для детей от 1 месяца до 10 лет в Москве.">
  <main>
    <HeroSlider />
    <WaveSection tone="blue">
      <div class="container"><div class="section-title"><h2 class="hand">〰 Наши занятия 〰</h2></div><div class="lesson-grid">{programs.slice(0,3).map(p => <article class="lesson-card"><img src={p.image} alt={p.title} /><div><h3>{p.title}</h3><strong>{p.age}</strong><p>{p.text}</p><a href={`${base}programs/`}>Подробнее →</a></div></article>)}</div></div>
    </WaveSection>
    <WaveSection>
      <div class="container"><div class="section-title"><h2 class="hand">〰 Абонементы и цены 〰</h2><p>Индивидуальные занятия продолжительностью 30 или 45 минут.</p></div><div class="price-grid">{prices.map(p => <article class:list={['price-card', p.featured && 'featured']}><small>{p.featured ? 'Первое знакомство' : 'Абонемент'}</small><h3>{p.title}</h3><strong>{p.price}</strong><p>{p.note}</p>{p.extra && <p>{p.extra}</p>}{p.featured && <a class="button" href={site.booking}>Записаться</a>}</article>)}</div></div>
    </WaveSection>
    <WaveSection tone="blue">
      <div class="container"><div class="section-title"><h2 class="hand">〰 Наши тренеры 〰</h2></div><div class="trainer-grid">{trainers.map(t => <article class="trainer-card"><img src={t.image} alt={`${t.name}, тренер`} /><div><h3 class="hand">{t.name}</h3><p>{t.role}</p></div></article>)}</div></div>
    </WaveSection>
    <WaveSection>
      <div class="container why-panel"><div><h2 class="hand">Почему выбирают нас</h2><div class="why-grid"><span>♡<b>Индивидуальный подход</b></span><span>⚓<b>Забота о каждом ребёнке</b></span><span>💧<b>Чистая вода 32–34 °C</b></span></div></div><img src={`${base}assets/images/pool-action-1.webp`} alt="Занятие в бассейне" /></div>
    </WaveSection>
  </main>
</BaseLayout>
