---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PricingSection from '@/components/PricingSection.astro';
import WaveSection from '@/components/WaveSection.astro';
import { site } from '@/data/site';
import '@/styles/detail-pages.css';
---

<BaseLayout title="Цены и абонементы на детское плавание | Кашалотик" description="Цены на пробное, разовое занятие и абонементы в детский бассейн «Кашалотик» в Чертаново. Индивидуальные занятия по 30 и 45 минут.">
  <main>
    <PageHero eyebrow="Цены и абонементы" title="Выберите удобный формат занятий" text="Пробное знакомство, разовое посещение или регулярные занятия — все варианты и условия собраны на одной странице." />

    <PricingSection />

    <WaveSection tone="blue">
      <div class="container detail-heading centered" data-reveal>
        <span>Запланируйте посещение</span>
        <h2>Выберите удобное время</h2>
        <p>Мы работаем ежедневно с 9:00 до 21:00. Свободное время и тренера можно выбрать при онлайн-записи.</p>
      </div>
      <div class="container schedule-bar" data-reveal-group>
        <span><b>Ежедневно</b>9:00–21:00</span>
        <span><b>Индивидуально</b>ребёнок и тренер</span>
        <span><b>Продолжительность</b>30 или 45 минут</span>
        <a class="button" href={site.booking}>Посмотреть свободное время</a>
      </div>
    </WaveSection>
  </main>
</BaseLayout>
