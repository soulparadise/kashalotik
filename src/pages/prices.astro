---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import WaveSection from '@/components/WaveSection.astro'; import { prices } from '@/data/content'; import { site } from '@/data/site';
---
<BaseLayout title="Расписание и цены — Кашалотик" description="Расписание, абонементы и стоимость занятий."><main><PageHero eyebrow="Расписание и цены" title="Выберите удобный формат занятий" text="Мы работаем ежедневно с 9:00 до 21:00. Время выбирается при онлайн-записи." /><WaveSection tone="blue"><div class="container"><div class="schedule-bar"><span><b>Ежедневно</b>9:00–21:00</span><span><b>Индивидуально</b>ребёнок и тренер</span><span><b>Продолжительность</b>30 или 45 минут</span><a class="button" href={site.booking}>Свободное время</a></div><div class="price-grid">{prices.map(p => <article class:list={['price-card', p.featured && 'featured']}><h2>{p.title}</h2><strong>{p.price}</strong><p>{p.note}</p>{p.extra && <p>{p.extra}</p>}</article>)}</div></div></WaveSection></main></BaseLayout>
