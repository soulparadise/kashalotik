---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import WaveSection from '@/components/WaveSection.astro'; import { site } from '@/data/site';
---
<BaseLayout title="Отзывы — Кашалотик" description="Отзывы и преимущества детского бассейна Кашалотик."><main><PageHero eyebrow="Отзывы" title="Нам доверяют самое важное" text="Забота, безопасность и тёплая атмосфера для первых уверенных шагов в воде." /><WaveSection tone="blue"><div class="container good-place"><span>★</span><div><small>Статус Яндекс Карт</small><h2 class="hand">«Хорошее место»</h2><p>Признание качества, безопасности и тёплой атмосферы бассейна.</p></div><a class="button" href={`${site.maps}reviews/`}>Читать отзывы</a></div></WaveSection></main></BaseLayout>
