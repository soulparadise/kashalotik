---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import WaveSection from '@/components/WaveSection.astro';
import { trainers, weeklySchedule } from '@/data/content';
import '@/styles/schedule.css';

const trainerByName = new Map(trainers.map(trainer => [trainer.name, trainer]));
---
<BaseLayout title="Расписание тренеров детского бассейна | Кашалотик" description="Регулярное расписание тренеров детского бассейна «Кашалотик». Выберите удобный день и перейдите к актуальным свободным окнам в YCLIENTS.">
  <main>
    <PageHero compact eyebrow="Планируем занятия" title="Расписание тренеров" text="Выберите удобный день и посмотрите свободное время нужного тренера." />
    <WaveSection tone="blue" class="schedule-page">
      <div class="container">
        <div class="schedule-note" data-reveal>
          <span aria-hidden="true">◷</span>
          <div>
            <p><strong>Показаны постоянные смены.</strong> Свободные окна — в онлайн-записи.</p>
            <a href={`${import.meta.env.BASE_URL}team/`}>Хотите сначала выбрать специалиста? Познакомиться с тренерами →</a>
          </div>
        </div>
        <div class="schedule-week" data-reveal-group>
          {weeklySchedule.map(day => (
            <article class="schedule-day">
              <header><span>{day.shortDay}</span><h2>{day.day}</h2></header>
              <div class="schedule-shifts">
                {day.shifts.map(shift => {
                  const trainer = trainerByName.get(shift.trainer);
                  return trainer && (
                    <a class="schedule-shift" href={trainer.booking} aria-label={`Онлайн-запись: ${trainer.name}, ${day.day}, ${shift.time}`}>
                      <img src={trainer.image} alt="" loading="lazy" width="52" height="52" />
                      <span class="schedule-shift-info"><time>{shift.time}</time><strong>{trainer.name}</strong></span>
                      <span class="schedule-shift-cta">Посмотреть свободное время <b aria-hidden="true">→</b></span>
                    </a>
                  );
                })}
              </div>
            </article>
          ))}
        </div>
      </div>
    </WaveSection>
  </main>
</BaseLayout>
