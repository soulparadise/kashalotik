---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import WaveSection from '@/components/WaveSection.astro';
import { trainers, weeklySchedule } from '@/data/content';
import '@/styles/schedule.css';

const trainerByName = new Map(trainers.map(trainer => [trainer.name, trainer]));
---
<BaseLayout title="Расписание тренеров детского бассейна | Кашалотик" description="Регулярное расписание тренеров детского бассейна «Кашалотик». Выберите удобный день и перейдите к актуальным свободным окнам в YCLIENTS.">
  <main>
    <PageHero eyebrow="Планируем занятия" title="Расписание тренеров" text="Выберите удобный день и сразу переходите к свободному времени нужного тренера." />
    <WaveSection tone="blue" class="schedule-page">
      <div class="container">
        <div class="schedule-note" data-reveal>
          <span aria-hidden="true">◷</span>
          <p><strong>На сайте указаны постоянные смены.</strong> Актуальные свободные окна и запись доступны по кнопке выбранного тренера.</p>
        </div>
        <div class="schedule-week" data-reveal-group>
          {weeklySchedule.map(day => (
            <article class="schedule-day">
              <header><span>{day.shortDay}</span><h2>{day.day}</h2></header>
              <div class="schedule-shifts">
                {day.shifts.map(shift => {
                  const trainer = trainerByName.get(shift.trainer);
                  return trainer && (
                    <a href={trainer.booking} aria-label={`Онлайн-запись: ${trainer.name}, ${day.day}, ${shift.time}`}>
                      <img src={trainer.image} alt="" loading="lazy" width="54" height="54" />
                      <span><strong>{trainer.name}</strong><time>{shift.time}</time><small>Свободное время →</small></span>
                    </a>
                  );
                })}
              </div>
            </article>
          ))}
        </div>
      </div>
    </WaveSection>
  </main>
</BaseLayout>
