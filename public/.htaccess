Options -MultiViews

RewriteEngine On

# Legacy URLs from the previous site. Keep every redirect direct and permanent.
RewriteRule ^programm/?$ https://kashalotik.ru/programs/ [R=301,L,NE]
RewriteRule ^individyalno/?$ https://kashalotik.ru/programs/ [R=301,L,NE]
RewriteRule ^vater/?$ https://kashalotik.ru/safety/ [R=301,L,NE]
RewriteRule ^page28635552\.html$ https://kashalotik.ru/rules/ [R=301,L,NE]

# Keep one canonical production origin: HTTPS without www or preview aliases.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^kashalotik\.ru$ [NC]
RewriteRule ^ https://kashalotik.ru%{REQUEST_URI} [R=301,L,NE]
